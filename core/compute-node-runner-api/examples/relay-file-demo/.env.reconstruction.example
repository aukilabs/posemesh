DDS_BASE_URL=https://dds.dev.aukiverse.com
DMS_BASE_URL=https://dms.dev.aukiverse.com/v1

# Existing reconstruction/Compute registration material. Keep this file out of
# git. The node must belong to the same organization as the App JWT when the
# Robot template uses dedicated task mode.
REG_SECRET=
SECP256K1_PRIVHEX=

# The Compute endpoint needs P2P enabled, but it does not advertise a dataset.
AUKI_P2P_ENABLED=true
# Use a distinct persistent identity for this reconstruction process. Generate
# it with `posemesh-p2p-keygen`; never reuse the Robot's key concurrently.
AUKI_P2P_PRIVATE_KEY_FILE=/absolute/path/to/reconstruction-libp2p-private-key
AUKI_P2P_LISTEN_MULTIADDRS=
AUKI_P2P_ADVERTISED_MULTIADDRS=

# The demo refuses to overwrite this destination.
RELAY_DEMO_OUTPUT_FILE=/tmp/posemesh-relay-file-demo.download

REGISTER_INTERVAL_SECS=30
REGISTER_MAX_RETRY=-1
MAX_CONCURRENCY=1
LOG_FORMAT=text
RUST_LOG=info
