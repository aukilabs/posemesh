# Dev control plane. The demo rejects non-dev hosts unless explicitly overridden.
DDS_BASE_URL=https://dds.dev.aukiverse.com
DMS_BASE_URL=https://dms.dev.aukiverse.com/v1

# Opaque Robot machine-registration credential issued by DDS.
ROBOT_REGISTRATION_CREDENTIALS_FILE=/absolute/path/to/robot-registration-credentials

# Dedicated persistent Ed25519 libp2p identity generated by
# `cargo run -p posemesh-compute-node --bin posemesh-p2p-keygen -- /absolute/path/to/libp2p-private-key`.
# Prefer the raw 0600 file. Alternatively set AUKI_P2P_PRIVATE_KEY to canonical
# padded Base64 of those same protobuf bytes, but never configure both.
AUKI_P2P_PRIVATE_KEY_FILE=/absolute/path/to/libp2p-private-key

# App JWT authorized to create jobs in DOMAIN_ID. Prefer a chmod 600 file.
APP_JWT_FILE=/absolute/path/to/dev-app-jwt
DOMAIN_ID=00000000-0000-0000-0000-000000000000

# Force a relay-only immutable reference: no direct advertised route is allowed
# by the demo binary.
AUKI_P2P_RELAY_MODE=always
AUKI_P2P_RELAY_BOOKING_MODE=public
AUKI_P2P_RELAY_BOOKING_DURATION_SECONDS=3600
AUKI_P2P_RELAY_COUNT=1
AUKI_P2P_RELAY_STATUS_POLL_INTERVAL_SECONDS=5
AUKI_P2P_LISTEN_MULTIADDRS=
AUKI_P2P_ADVERTISED_MULTIADDRS=

# Any non-empty file works. It is served in place until available_until.
RELAY_DEMO_SOURCE_FILE=/absolute/path/to/existing-file.bin
RELAY_DEMO_REFERENCE_FILE=/tmp/posemesh-relay-file-demo.reference.json
RELAY_DEMO_AVAILABILITY_SECONDS=600

# Dedicated is safest for dev: it prevents an unrelated public node from
# claiming the download. Use public only if the reconstruction credential is a
# public node and no other matching dev node is running.
RELAY_DEMO_RECONSTRUCTION_TASK_MODE=dedicated
RELAY_DEMO_NODE_WAIT_SECONDS=120

MAX_CONCURRENCY=1
LOG_FORMAT=text
RUST_LOG=info
