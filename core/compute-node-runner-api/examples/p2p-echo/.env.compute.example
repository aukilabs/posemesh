# Source the configured copy in the Compute terminal; binaries do not load .env.
export DDS_BASE_URL=https://DDS_HOST
export DMS_BASE_URL=https://DMS_HOST/v1
export ECHO_ORGANIZATION_ID=ORGANIZATION_UUID
export ECHO_DOMAIN_ID=ROBOT_ASSIGNED_DOMAIN_UUID
# Provision this Compute node as dedicated in DDS, in ECHO_ORGANIZATION_ID.
# Task mode is set by the submission helper; there is no NODE_MODE env override.
# Complete DDS registration credentials (node ID and secret encoded together).
export REG_SECRET=COMPUTE_REGISTRATION_CREDENTIALS
export SECP256K1_PRIVHEX=COMPUTE_WALLET_PRIVATE_KEY
export AUKI_P2P_ENABLED=true
export AUKI_P2P_PRIVATE_KEY_FILE=/absolute/path/to/compute-peer.key
export LOG_FORMAT=text
