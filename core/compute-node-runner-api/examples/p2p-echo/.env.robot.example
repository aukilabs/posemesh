# Source the configured copy in the Robot terminal; binaries do not load .env.
export DDS_BASE_URL=https://DDS_HOST
export DMS_BASE_URL=https://DMS_HOST/v1
export ECHO_ORGANIZATION_ID=ORGANIZATION_UUID
export ECHO_DOMAIN_ID=ROBOT_ASSIGNED_DOMAIN_UUID
# Provision and assign this Robot in the same organization and Domain in DDS.
export ROBOT_REGISTRATION_CREDENTIALS_FILE=/absolute/path/to/robot-credential
export AUKI_P2P_ENABLED=true
export AUKI_P2P_PRIVATE_KEY_FILE=/absolute/path/to/robot-peer.key
export AUKI_P2P_RELAY_MODE=auto
export AUKI_P2P_RELAY_BOOKING_MODE=public
export AUKI_P2P_RELAY_COUNT=1
export LOG_FORMAT=text
# For a local direct-only run, replace relay mode with disabled and set:
# export AUKI_P2P_LISTEN_MULTIADDRS=/ip4/127.0.0.1/tcp/4001
# export AUKI_P2P_ADVERTISED_MULTIADDRS=/ip4/127.0.0.1/tcp/4001
