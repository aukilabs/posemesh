{
  "name": "@auki/domain-client-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Test suite for @auki/domain-client",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:browser": "vitest --config=vitest.browser.config.js",
    "test:browser:run": "vitest run --config vitest.browser.config.js",
    "test:browser:ui": "vitest --ui --config vitest.browser.config.js",
    "test:browser:watch": "vitest --watch --config vitest.browser.config.js",
    "test:all": "npm run test:run && npm run test:browser:run",
    "test:bindings": "vitest run bindings.test.ts && vitest run --config vitest.browser.config.js bindings.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^17.2.2",
    "playwright": "^1.40.0",
    "vite": "^6.4.3",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auki/domain-client": "file:../pkg"
  },
  "overrides": {
    "vite-plugin-top-level-await": {
      "uuid": "^11.1.1"
    }
  }
}
